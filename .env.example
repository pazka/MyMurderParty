# my-murder-party environment. Copy to my-murder-party.env (chmod 600). Nothing secret here:
# the app has no login and keeps its state in memory.
# required:
# (no owner secret is needed)

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/my-murder-party:v1.2.0'
APP_BIND='127.0.0.1:9137'

# --- app ---
# Config set (Back/services/config.ts): PROD = CORS https://murder.hosh.it, session cookie
# Domain=.hosh.it HttpOnly Secure SameSite=Strict. Same value as the legacy compose.
ENV=PROD
